---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = [
	{
		title: 'Project One',
		description:
			'A short description of what you built, the problem it solved, and the impact it had.',
		stack: ['TypeScript', 'React', 'Postgres'],
		href: '#',
	},
	{
		title: 'Project Two',
		description:
			'Another concise summary highlighting interesting technical decisions or the scale of the system.',
		stack: ['Node.js', 'AWS', 'Redis'],
		href: '#',
	},
	{
		title: 'Project Three',
		description:
			'A third project showcasing breadth — a different domain, language, or part of the stack.',
		stack: ['Astro', 'Tailwind', 'Cloudflare'],
		href: '#',
	},
];

const frontendSkills = [
	'TypeScript',
	'React',
  'Storybook',
  'Tanstack Router',
  'Tanstack Query',
  'Tasnstack Table',
  'Shadcn',
];

const backendSkills = [
	'Node.js',
	'Golang',
	'Postgres',
	'AWS',
  'Azure',
	'Docker',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Fullstack Software Engineer</p>
				<h1>
					Hi, I'm <span class="accent">Noel Vega</span>.<br />
					I build fast, thoughtful web experiences.
				</h1>
				<p class="lede">
					I design and ship modern web applications — from clean interfaces to the systems
					behind them. I care about performance, clarity, and details that make products
					feel effortless.
				</p>
				<div class="cta-row">
					<a class="btn btn-primary" href="#work">View my work</a>
					<a class="btn btn-ghost" href="mailto:noelvegajr94@gmail.com">Get in touch</a>
				</div>
			</section>

			<section id="work" class="section">
				<header class="section-head">
					<h2>Selected work</h2>
					<p>A few projects I've enjoyed building recently.</p>
				</header>
				<div class="grid">
					{
						projects.map((project) => (
							<a class="card" href={project.href}>
								<div class="card-body">
									<h3>{project.title}</h3>
									<p>{project.description}</p>
								</div>
								<div class="tags">
									{project.stack.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							</a>
						))
					}
				</div>
			</section>

			<section class="section">
				<header class="section-head">
					<h2>Stack &amp; tools</h2>
					<p>Technologies I reach for most often.</p>
				</header>
				<div class="skill-groups">
					<div class="skill-group">
						<h3>Frontend</h3>
						<ul class="skills">
							{frontendSkills.map((skill) => <li>{skill}</li>)}
						</ul>
					</div>
					<div class="skill-group">
						<h3>Backend</h3>
						<ul class="skills">
							{backendSkills.map((skill) => <li>{skill}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section class="section contact">
				<h2>Let's build something.</h2>
				<p>
					I'm open to interesting projects and roles. The fastest way to reach me is email.
				</p>
				<a class="btn btn-primary" href="mailto:noelvegajr94@gmail.com">
					noelvegajr94@gmail.com
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		padding: 4em 1.25em 2em;
	}

	.hero {
		padding: 2em 0 4em;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.78em;
		font-weight: 600;
		color: rgb(var(--gray));
		margin: 0 0 1.25em;
	}

	.hero h1 {
		font-size: clamp(2.25rem, 5vw + 1rem, 3.75rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
	}

	.accent {
		background: linear-gradient(120deg, var(--accent), #6c7bff);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.lede {
		max-width: 38em;
		font-size: 1.1em;
		color: rgb(var(--gray-dark));
		margin: 0 0 2em;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.7em 1.4em;
		border-radius: 999px;
		font-size: 0.95em;
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			background 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.btn-primary {
		background: rgb(var(--black));
		color: #fff;
	}

	.btn-primary:hover {
		background: var(--accent);
		color: #fff;
		transform: translateY(-1px);
	}

	.btn-ghost {
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--black));
		background: transparent;
	}

	.btn-ghost:hover {
		border-color: rgb(var(--gray-dark));
		color: rgb(var(--black));
	}

	.section {
		padding: 3.5em 0;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.section-head {
		margin-bottom: 2em;
	}

	.section-head h2 {
		font-size: 1.75em;
		letter-spacing: -0.01em;
		margin: 0 0 0.35em;
	}

	.section-head p {
		color: rgb(var(--gray));
		margin: 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25em;
	}

	.card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1.5em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		background: #fff;
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-3px);
		border-color: rgb(var(--gray));
		box-shadow: 0 10px 30px rgba(var(--gray), 18%);
	}

	.card h3 {
		font-size: 1.15em;
		margin: 0 0 0.4em;
	}

	.card p {
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
		margin: 0 0 1.25em;
		line-height: 1.55;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}

	.tag {
		font-size: 0.75em;
		font-weight: 500;
		padding: 0.25em 0.7em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}

	.skill-groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 2em;
	}

	.skill-group h3 {
		font-size: 0.78em;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-weight: 600;
		color: rgb(var(--gray));
		margin: 0 0 1em;
	}

	.skills {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		padding: 0;
		margin: 0;
	}

	.skills li {
		padding: 0.5em 1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		font-size: 0.9em;
		color: rgb(var(--gray-dark));
		background: #fff;
	}

	.contact {
		text-align: center;
	}

	.contact h2 {
		font-size: 2em;
		margin: 0 0 0.5em;
	}

	.contact p {
		color: rgb(var(--gray));
		max-width: 30em;
		margin: 0 auto 1.5em;
	}

	@media (max-width: 720px) {
		main {
			padding: 2em 1em 1em;
		}
		.hero {
			padding: 1em 0 2em;
		}
		.section {
			padding: 2.5em 0;
		}
	}
</style>
