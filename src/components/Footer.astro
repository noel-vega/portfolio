---
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="left">
			<a href="/" class="brand">
				<span class="badge">N</span>
				<span class="brand-text">Noel Vega</span>
			</a>
			<p class="tagline">Web developer building fast, thoughtful experiences.</p>
		</div>

		<nav class="links" aria-label="Footer">
			<a href="/">Home</a>
			<a href="/blog">Blog</a>
			<a href="/about">About</a>
			<a href="mailto:noelvegajr94@gmail.com">Contact</a>
		</nav>

		<div class="social">
			<a
				href="https://www.linkedin.com/in/your-username"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Connect on LinkedIn"
			>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6h2.275v1.04h.032c.317-.6 1.091-1.232 2.246-1.232 2.4 0 2.845 1.58 2.845 3.637v4.19zM3.558 4.957a1.374 1.374 0 1 1 0-2.748 1.374 1.374 0 0 1 0 2.748zm1.187 8.678h-2.37V6h2.37v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0z"
					></path></svg
				>
			</a>
		</div>
	</div>

	<div class="bottom">
		<p>&copy; {today.getFullYear()} Noel Vega. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid rgb(var(--gray-light));
		background: #fff;
		color: rgb(var(--gray-dark));
	}

	.inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 2rem;
		max-width: 960px;
		margin: 0 auto;
		padding: 3rem 1.25rem 1.5rem;
	}

	.left {
		max-width: 22rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: rgb(var(--black));
	}

	.badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: rgb(var(--black));
		color: #fff;
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: -0.02em;
	}

	.brand-text {
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.tagline {
		margin: 0.75rem 0 0;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		line-height: 1.55;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
	}

	.links a {
		padding: 0.4rem 0.7rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 500;
		color: rgb(var(--gray));
		text-decoration: none;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.links a:hover {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}

	.social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		color: rgb(var(--gray));
		text-decoration: none;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.social a:hover {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}

	.bottom {
		max-width: 960px;
		margin: 0 auto;
		padding: 1rem 1.25rem 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.bottom p {
		margin: 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	@media (max-width: 640px) {
		.inner {
			flex-direction: column;
			gap: 1.5rem;
			padding-top: 2rem;
		}
	}
</style>
