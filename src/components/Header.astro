---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="bar">
		<a href="/" class="brand">
			<span class="badge">N</span>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>
		<nav class="nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		<a
			class="social"
			href="https://www.linkedin.com/in/your-username"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Connect on LinkedIn"
		>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
				><path
					fill="currentColor"
					d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6h2.275v1.04h.032c.317-.6 1.091-1.232 2.246-1.232 2.4 0 2.845 1.58 2.845 3.637v4.19zM3.558 4.957a1.374 1.374 0 1 1 0-2.748 1.374 1.374 0 0 1 0 2.748zm1.187 8.678h-2.37V6h2.37v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0z"
				></path></svg
			>
		</a>
	</div>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.78);
		backdrop-filter: saturate(180%) blur(12px);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.bar {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 1rem;
		max-width: 960px;
		margin: 0 auto;
		padding: 0.75rem 1.25rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: rgb(var(--black));
		white-space: nowrap;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: rgb(var(--black));
		color: #fff;
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: -0.02em;
	}

	.brand-text {
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin-left: auto;
	}

	.nav :global(a) {
		padding: 0.45rem 0.85rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 500;
		color: rgb(var(--gray));
		text-decoration: none;
		white-space: nowrap;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.nav :global(a:hover) {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}

	.nav :global(a.active) {
		color: rgb(var(--black));
		font-weight: 600;
	}

	.social {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		color: rgb(var(--gray));
		text-decoration: none;
		margin-left: 0.25rem;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.social:hover {
		color: rgb(var(--black));
		background: rgb(var(--gray-light));
	}

	@media (max-width: 540px) {
		.bar {
			padding: 0.65rem 1rem;
			gap: 0.5rem;
		}
		.brand-text {
			display: none;
		}
		.nav :global(a) {
			padding: 0.4rem 0.6rem;
			font-size: 0.85rem;
		}
	}
</style>
